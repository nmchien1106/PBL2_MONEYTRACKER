   <string notr="true">QDialog {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f8f9fa, stop:1 #e9ecef);
}

QLabel {
    font-size: 13px;
    font-weight: 500;
    color: #495057;
}

QLabel#titleLabel {
    font-size: 24px;
    font-weight: 700;
    color: #212529;
}

QLineEdit, QTextEdit, QComboBox, QDateTimeEdit, QDateEdit {
    padding: 10px;
    border: 2px solid #ced4da;
    border-radius: 8px;
    background: white;
    font-size: 13px;
    color: #212529;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QDateTimeEdit:focus, QDateEdit:focus {
    border-color: #FF6B6B;
    outline: none;
}

QComboBox::drop-down, QDateEdit::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow, QDateEdit::down-arrow {
    width: 12px;
    height: 12px;
}

QCheckBox {
    font-size: 13px;
    font-weight: 600;
    color: #495057;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #ced4da;
    border-radius: 4px;
    background: white;
}

QCheckBox::indicator:checked {
    background: #FF6B6B;
    border-color: #FF6B6B;
}

QPushButton {
    padding: 12px 24px;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    min-width: 120px;
}

QPushButton#submitButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #FF6B6B, stop:1 #EE5A52);
    color: white;
}

QPushButton#submitButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #EE5A52, stop:1 #DC4C41);
}

QPushButton#cancelButton {
    background: #6c757d;
    color: white;
}

QPushButton#cancelButton:hover {
    background: #5a6268;
}

QFrame#separatorLine {
    background-color: #dee2e6;
    max-height: 1px;
}</string>
