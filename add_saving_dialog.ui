}

QLabel {
    font-size: 13px;
    font-weight: 500;
    color: #495057;
}

QLabel#titleLabel {
    font-size: 24px;
    font-weight: 700;
    color: #212529;
}

QLineEdit, QTextEdit, QDateTimeEdit {
    padding: 10px;
    border: 2px solid #ced4da;
    border-radius: 8px;
    background: white;
    font-size: 13px;
    color: #212529;
}

QLineEdit:focus, QTextEdit:focus, QDateTimeEdit:focus {
    border-color: #4ECDC4;
    outline: none;
}

QDateTimeEdit::drop-down {
    border: none;
    width: 30px;
}

QDateTimeEdit::down-arrow {
    width: 12px;
    height: 12px;
}

QPushButton {
    padding: 12px 24px;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    min-width: 120px;
}

QPushButton#submitButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #4ECDC4, stop:1 #44A39B);
    color: white;
}

QPushButton#submitButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #44A39B, stop:1 #3A8B84);
}

QPushButton#cancelButton {
    background: #6c757d;
    color: white;
}

QPushButton#cancelButton:hover {
    background: #5a6268;
}

QFrame#separatorLine {
    background-color: #dee2e6;
    max-height: 1px;
}</string>
